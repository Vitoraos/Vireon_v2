# --- Sahara (Intron Voice) ---
SAHARA_API_KEY=your_key_here
SAHARA_STT_BASE_URL=https://infer.voice.intron.io
SAHARA_TTS_BASE_URL=https://infer.voice.intron.io

# PLACEHOLDER 1 — flip to "streaming" once Integrator Account access is confirmed.
# batch = current upload -> poll flow (works today, higher latency)
# streaming = wss://infer.voice.intron.io/stt/v1/stream (lower latency, needs Integrator Account)
SAHARA_STT_MODE=batch

# PLACEHOLDER 2 — flip to "streaming" once confirmed Sahara TTS has a chunked/streaming endpoint.
# batch = request -> full audio back (works today, adds full-generation latency before playback)
# streaming = chunked audio as it's generated (needs confirmation this endpoint exists)
SAHARA_TTS_MODE=batch

# --- Qwen 3 (self-hosted, vLLM OpenAI-compatible server) ---
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen3-4B-Instruct
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_MS=8000

# --- Translation / normalization model (for red-flag + slot extraction, NOT for patient-facing text) ---
TRANSLATE_BASE_URL=http://localhost:8001/v1
TRANSLATE_MODEL=nllb-200-distilled-600M
TRANSLATE_TIMEOUT_MS=4000

# --- Supabase ---
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# --- Server ---
PORT=3001
